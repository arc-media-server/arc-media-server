<?xml version="1.0" encoding="utf-8"?>
<!--
  Arc usually runs on the home network at http://<address>:8099, so plain HTTP has to be allowed
  for whatever address the person types. HTTPS (remote access) is used whenever the address says so.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
