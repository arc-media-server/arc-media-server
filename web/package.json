{
  "name": "ams-web",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run test:i18n && npm run test:unit && tsc -b && vite build",
    "typecheck": "tsc -b",
    "test:adaptive": "node e2e/adaptive-policy.test.mjs",
    "test:e2e": "npm run build && tsc -p e2e/tsconfig.json && npm run test:e2e:only",
    "test:e2e:only": "npm run test:adaptive && playwright test",
    "test:i18n": "node --test tools/i18n.test.mjs tools/home-i18n.test.mjs tools/browsing-i18n.test.mjs",
    "test:unit": "node --test tools/watch-together.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@scalar/api-reference": "1.74.0",
    "@tanstack/react-query": "^5.104.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hls.js": "^1.7.3",
    "i18next": "^26.5.11",
    "i18next-browser-languagedetector": "^8.2.3",
    "lucide-react": "^1.58.0",
    "motion": "^14.3.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-router": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
